#!/bin/zsh

# FAKE_CONDUCTOR_BRIDGE_MARKER;v0.1

set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
REAL="$DIR/conductor-runtime.real"
NODE="$DIR/node"
BRIDGE="$DIR/runtime-proxy.mjs"

# As of v0.74 on launch Conductor runs `conduct-runtime --version`, and if it doesn't get the response it wants, won't start.
# Thus if we get `--version` passed to us, forward it to the real version.
if [[ "${1:-}" == "--version" && ! -x "$REAL" ]]; then
  REAL="$HOME/Library/Application Support/com.conductor.app/bin/.internal/conductor-runtime.real"
fi

if [[ ! -x "$REAL" ]]; then
  echo "Missing real Conductor runtime: $REAL" >&2
  exit 127
fi

if [[ "${1:-}" == "sidecar" ]]; then
  exec "$NODE" "$BRIDGE" "$REAL" "$@"
else
    exec "$REAL" "$@"
fi
